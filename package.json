    "bsc",
    "polygon",
    "arbitrum",
    "optimism"
  ],
  "author": "Multicoin Team <dev@multicoin.com>",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "php": ">=8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/multicoin/token-sweeper"
  }
}
