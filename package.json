    "test:node": "jest",
    "test:watch": "jest --watch",
    "install:all": "composer install && npm install"
  },
  "keywords": [
    "ethereum",
    "laravel",
    "nodejs",
    "token",
    "sweeper",
    "blockchain",
    "web3",
