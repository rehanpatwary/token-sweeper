{
  "name": "multicoin-token-sweeper",
  "version": "1.0.0",
  "description": "Multi-chain token sweeping system with Laravel and Node.js implementations",
  "main": "nodejs/src/index.js",
  "scripts": {
    "start": "node nodejs/src/index.js",
    "dev": "nodemon nodejs/src/index.js",
    "test": "npm run test:php && npm run test:node",
