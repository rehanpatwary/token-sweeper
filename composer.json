{
    "name": "multicoin/token-sweeper",
    "description": "Multi-chain token sweeping package for Laravel with Node.js support",
    "type": "library",
    "keywords": [
        "laravel",
        "nodejs",
        "ethereum",
        "blockchain",
        "token",
        "sweeper",
        "web3",
        "crypto",
        "multi-chain",
        "bsc",
        "polygon",
        "arbitrum",
        "optimism"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Multicoin Team",
            "email": "dev@multicoin.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/console": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0",
        "simplito/elliptic-php": "^1.0",
        "kornrunner/keccak": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^8.0|^9.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Multicoin\\TokenSweeper\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Multicoin\\TokenSweeper\\Tests\\": "php/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Multicoin\\TokenSweeper\\TokenSweeperServiceProvider"
            ],
            "aliases": {
                "TokenSweeper": "Multicoin\\TokenSweeper\\Facades\\TokenSweeper"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature",
        "test:php": "phpunit",
        "format": "php-cs-fixer fix"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
